% Cal State LA Beamer theme
% Mimics the California State University, Los Angeles visual identity
% (Cal State LA Gold + Black, Montserrat / Open Sans typography) without
% using the university logo. No official logo or mark is embedded.
%
% Compile with XeLaTeX for authentic Montserrat/Open Sans typography:
%     xelatex 02-ai_intro.tex
% Falls back gracefully under pdfLaTeX.
\mode<presentation>

\usefonttheme{CalStateLA}
\usecolortheme{CalStateLA}
\useinnertheme{CalStateLA}
\useoutertheme{CalStateLA}

\mode<all>
