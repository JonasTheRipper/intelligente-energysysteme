# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.cache/

# CI / coverage
report-*.xml
.coverage
htmlcov/

# Real SRTM DEM mosaic cache (71 MB binary; regenerate via
# data/dem/fetch_dem_tiles.py using an OpenTopography API key)
data/dem/*.npz

# v0.6 satellite basemap tile cache (regenerated on demand by
# analysis/satellite_basemap.py from public Esri World Imagery tiles)
data/basemap_cache/

# Simulation outputs (regenerated by analysis/run_5day.py and MIDAS runs)
_outputs/
*.log
midas_socal/run.log
analysis/run_5day.log

# Rendered comparison timelapse / figure output dirs (regenerated by
# analysis/make_comparison_timelapse.py)
analysis/_v05_eaton/
analysis/_v05_palisades/
analysis/_v05_*/

# editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# local virtualenvs
.venv/
venv/
env/
.pg_password
pgdata/
pgsock/
# Local PostgreSQL runtime configs contain a DB password -> never commit.
runtime_pg*.conf.yaml

# GitLab push helper embeds credential handling for local use only.
push_to_gitlab.py
